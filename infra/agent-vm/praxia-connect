#!/usr/bin/env bash
# The agent's Praxia connection, as the agent user. Gets an agent token from Praxia with the VM's own identity and
# installs it as the user-scope `praxia` MCP entry of Claude Code; no person copies a secret.
#
#   praxia-connect --again   asks for a reconnect: writes the request flag and starts praxia-connect.service, then
#                            returns. Always this, from anywhere: the agent's session inherits claude-agent.service's
#                            INVOCATION_ID, so the environment cannot tell the agent from the worker.
#   praxia-connect --run     the worker; only praxia-connect.service's ExecStart passes it (timer, first boot, --again)
#
# The worker, under one lock:
#   1. nothing to do without PRAXIA_URL and CONNECT_RESOURCE in /etc/agentvm.conf
#   2. nothing to do once connected (the marker) unless a reconnect was asked: a token the person revoked on Praxia's
#      Claude access page is never minted again by itself
#   3. the marker goes first and the request is taken, so a run that dies from here on is retried by the timer
#   4. the identity token for CONNECT_RESOURCE (Praxia's connect audience, which conde's enrol refuses) from the
#      metadata service, sent to Praxia's POST /api/agent/connect; Praxia mints the token and revokes the earlier one
#   5. claude mcp remove/add/get; the token is in add's arguments for that call (VM-wide, inside the VMs' trust
#      boundary, README); no child's output is kept, only exit codes are logged
#   6. a running, signed-in agent session is restarted so it loads the entry (it resumes its pinned session); one that
#      is not running or not signed in reads it at its next start
#   7. the marker, last
# Nothing but statuses and error codes is printed: never the identity token or the agent token.
set -uo pipefail
CONF="${AGENTVM_CONF:-/etc/agentvm.conf}"
# shellcheck source=/dev/null
[ -f "$CONF" ] && . "$CONF"
IMDS="${AGENTVM_IMDS:-http://169.254.169.254/metadata}"
DIR="$HOME/.config/agentvm"
MARKER="$DIR/praxia-connected"
REQUEST="$DIR/praxia-reconnect"
CURL=(curl -sS --connect-timeout 10 --max-time 60)

log() { echo "praxia-connect: $*" >&2; }

case "${1:-}" in
  --again)
    { mkdir -p "$DIR" && : > "$REQUEST"; } || { log "the request flag was not written"; exit 1; }
    exec systemctl --user start --no-block praxia-connect.service ;;
  --run) ;;
  *) echo "usage: praxia-connect --again | --run" >&2; exit 2 ;;
esac

exec 9>"${XDG_RUNTIME_DIR:-/tmp}/agentvm-praxia-connect.lock"
flock -n 9 || { log "another run holds the lock"; exit 0; }

# --- 1, 2
if [ -z "${PRAXIA_URL:-}" ] || [ -z "${CONNECT_RESOURCE:-}" ]; then
  log "no PRAXIA_URL or CONNECT_RESOURCE: not connecting"; exit 0
fi
[ -f "$MARKER" ] && [ ! -f "$REQUEST" ] && exit 0

# --- 3
mkdir -p "$DIR"
rm -f "$MARKER" "$REQUEST"

# --- 4
resource=$(jq -rn --arg r "$CONNECT_RESOURCE" '$r|@uri')
out=$("${CURL[@]}" -H Metadata:true -w '\n%{http_code}' "$IMDS/identity/oauth2/token?api-version=2018-02-01&resource=$resource")
rc=$?
code=${out##*$'\n'}
[ "$rc" -eq 0 ] || { log "identity token: metadata service unreachable (curl $rc)"; exit 1; }
[ "$code" = 200 ] || { log "identity token: HTTP $code"; exit 1; }
tok=$(printf '%s' "${out%$'\n'*}" | jq -r '.access_token // empty' 2>/dev/null)
unset out
[ -n "$tok" ] || { log "identity token: 200 without access_token"; exit 1; }

out=$(printf 'Authorization: Bearer %s\n' "$tok" | "${CURL[@]}" -X POST "$PRAXIA_URL/api/agent/connect" -H @- \
        -H 'Content-Type: application/json' --data '{"v":1}' -w '\n%{http_code}')
rc=$?
unset tok
code=${out##*$'\n'}; body=${out%$'\n'*}; unset out
[ "$rc" -eq 0 ] || { log "connect: Praxia unreachable or too slow (curl $rc)"; exit 1; }
[[ $code =~ ^[0-9]{3}$ ]] || { log "connect: unreadable response"; exit 1; }
if [ "$code" != 201 ]; then
  log "connect: HTTP $code $(printf '%s' "$body" | jq -rc '.error // "-"' 2>/dev/null || echo '(no JSON body)')"
  exit 1
fi
token=$(printf '%s' "$body" | jq -r '.token // empty' 2>/dev/null)
unset body
[ -n "$token" ] || { log "connect: 201 without a token"; exit 1; }
# it goes into an argument: one plain word or nothing
[[ $token =~ ^[A-Za-z0-9_.-]+$ ]] || { log "connect: the token is not one plain word; not installed"; exit 1; }

# --- 5
claude mcp remove --scope user praxia >/dev/null 2>&1
claude mcp add --transport http --scope user praxia "$PRAXIA_URL/mcp" --header "Authorization: Bearer $token" \
  >/dev/null 2>&1
rc=$?
unset token
[ "$rc" -eq 0 ] || { log "claude mcp add failed (exit $rc)"; exit 1; }
claude mcp get praxia >/dev/null 2>&1 || { log "claude mcp get praxia failed after the add"; exit 1; }
chmod 0600 "$HOME/.claude.json" || { log ".claude.json: chmod failed"; exit 1; }
[ "$(stat -c %u "$HOME/.claude.json")" = "$(id -u)" ] || { log ".claude.json is not the agent's"; exit 1; }

# --- 6
if systemctl --user is-active --quiet claude-agent \
   && claude auth status --json 2>/dev/null | jq -e '.loggedIn == true' >/dev/null 2>&1; then
  systemctl --user restart claude-agent || { log "the agent session's restart failed"; exit 1; }
  for _ in $(seq 30); do systemctl --user is-active --quiet claude-agent && break; sleep 1; done
  systemctl --user is-active --quiet claude-agent || { log "the agent session did not come back"; exit 1; }
  log "connected; the agent session was restarted to load it"
else
  log "connected; the agent session is not running or not signed in, and loads it at its start"
fi

# --- 7
date -u +%FT%TZ > "$MARKER"
