#!/usr/bin/env bash
# First boot of a VM made from the agent image (agentvm-firstboot.service, root, once). Joins the board without
# a person: the VM's own system-assigned identity is the proof (the mint call, design section "The two seam
# contracts", 1). Then it sets the agent up, and the session starts as soon as the person has signed in to
# Claude through the page.
#
#   1. settings from the VM's userData (instance metadata service)
#   2. an Entra token for this VM's identity, resource the conde application (its bare application id)
#   3. POST /v1/machines/enrol with it: the host key, once per identity
#   4. conde enroll with that key on stdin, retried while the key is held (the mint has no replay); the key is
#      never in an argument, a file or the log
#   5. conde setup, after the enrollment, so the skill names the board and the bridge starts on the new key
#   6. agent.env with a pinned session id, and claude-agent.service enabled (it waits for the Claude sign-in)
#
# Retried until one 30-minute deadline: network errors and timeouts, 5xx, 404 (the server may not have this
# VM's identity yet while its deployment finishes), 429 (Retry-After); the metadata service's transient answers
# (404, 410, 429, 5xx). Every other 4xx is final. The outcome goes to the journal: journalctl -u agentvm-firstboot.
set -euo pipefail

CONF=/etc/agentvm.conf
[ -f "$CONF" ] && . "$CONF"
AGENT_USER="${AGENT_USER:-agent}"
WORK_DIR_NAME="${WORK_DIR_NAME:-work}"
PERMISSION_MODE="${PERMISSION_MODE:-bypassPermissions}"
STATE=/var/lib/agentvm
DONE=$STATE/firstboot-done
ENROLLED=$STATE/enrolled          # written after conde enroll succeeded: a re-run never mints again
IMDS="${AGENTVM_IMDS:-http://169.254.169.254/metadata}"
DEADLINE=$(( $(date +%s) + 30 * 60 ))
CURL=(curl -sS --connect-timeout 10 --max-time 60)

log() { echo "agentvm-firstboot: $*" >&2; }   # stderr: some callers run inside $(...)
die() { log "FAILED: $*"; exit 1; }

uid=$(id -u "$AGENT_USER")
home=$(getent passwd "$AGENT_USER" | cut -d: -f6)
for _ in $(seq 120); do [ -S "/run/user/$uid/bus" ] && break; sleep 1; done
as_agent() {
  sudo -u "$AGENT_USER" -H env XDG_RUNTIME_DIR="/run/user/$uid" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" PATH="$home/.local/bin:/usr/local/bin:/usr/bin:/bin" \
    bash -lc "cd ~ && $1"
}
q() { printf '%q' "$1"; }

# Waits before the next attempt: max(hint, backoff) seconds, clamped to the time left; dies at the deadline.
backoff=5
retry_wait() {  # $1 what failed, $2 optional server hint in seconds (Retry-After)
  local now left wait=$backoff
  now=$(date +%s); left=$(( DEADLINE - now ))
  [ "$left" -gt 0 ] || die "$1; still failing after 30 minutes"
  case "${2:-}" in ''|*[!0-9]*) ;; *) [ "$2" -gt "$wait" ] && wait=$2 ;; esac
  [ "$wait" -gt "$left" ] && wait=$left
  log "$1; retrying in $wait s"; sleep "$wait"
  backoff=$(( backoff < 120 ? backoff * 2 : 120 ))
}

# GET from the metadata service; prints the body. Transient answers are retried, others are final: the script
# dies, or with $3 = optional the call returns 1 and the caller goes on with its defaults.
imds_get() {  # $1 path and query, $2 what, $3 optional
  local out rc code body detail
  backoff=5
  while :; do
    set +e; out=$("${CURL[@]}" -H Metadata:true -w '\n%{http_code}' "$IMDS/$1"); rc=$?; set -e
    code=${out##*$'\n'}; body=${out%$'\n'*}
    if [ "$rc" -ne 0 ]; then retry_wait "$2: metadata service unreachable (curl $rc)"; continue; fi
    case "$code" in
      200) printf '%s' "$body"; return 0 ;;
      404|410|429|5??) retry_wait "$2: metadata service HTTP $code $(printf '%s' "$body" | jq -rc '[.error, .error_description] | map(select(.)) | join(": ")' 2>/dev/null)" ;;
      *) detail="$2: metadata service HTTP $code $(printf '%s' "$body" | jq -rc '[.error, .error_description] | map(select(.)) | join(": ")' 2>/dev/null || printf '%s' "$body" | head -c 300)"
         [ "${3:-}" = optional ] && { log "$detail; using the defaults"; return 1; }
         die "$detail" ;;
    esac
  done
}

# --- 1. settings: userData from the template, then /etc/agentvm.conf
ud=$(imds_get "instance/compute/userData?api-version=2021-01-01&format=text" "userData" optional | base64 -d 2>/dev/null || true)
CONDE_SERVER=$(printf '%s' "$ud" | jq -r '.condeServer // empty' 2>/dev/null || true)
CONDE_SERVER="${CONDE_SERVER:-${CONDE_SERVER_DEFAULT:-https://dakai.conde.cloud}}"
CONDE_RESOURCE=$(printf '%s' "$ud" | jq -r '.condeResource // empty' 2>/dev/null || true)
CONDE_RESOURCE="${CONDE_RESOURCE:-${CONDE_RESOURCE_DEFAULT:-}}"
[ -n "$CONDE_RESOURCE" ] || die "no conde resource (userData condeResource or CONDE_RESOURCE_DEFAULT)"
log "server $CONDE_SERVER, resource $CONDE_RESOURCE"
mkdir -p "$STATE"

if [ -f "$ENROLLED" ]; then
  log "already enrolled (a reboot during first boot); skipping the mint"
else
  # --- 2. the identity token
  tok=$(imds_get "identity/oauth2/token?api-version=2018-02-01&resource=$(jq -rn --arg r "$CONDE_RESOURCE" '$r|@uri')" "identity token" \
        | jq -r '.access_token // empty')
  [ -n "$tok" ] || die "identity token: 200 without access_token"

  # --- 3. the mint call
  backoff=5
  while :; do
    set +e
    resp=$(printf 'Authorization: Bearer %s\n' "$tok" | "${CURL[@]}" -X POST "$CONDE_SERVER/v1/machines/enrol" -H @- \
             -H 'Content-Type: application/json' --data '{"v":1}' -w '\n%header{retry-after}\n%{http_code}')
    rc=$?; set -e
    # The status code is last and never empty, so $(...) cannot strip a field. Nothing but a validated status
    # code and the error fields is ever printed: the 200 body holds the key.
    code=${resp##*$'\n'}; resp=${resp%$'\n'*}
    ra=${resp##*$'\n'}; body=${resp%$'\n'*}; unset resp
    if [ "$rc" -ne 0 ]; then retry_wait "enrol: network error or timeout (curl $rc)"; continue; fi
    [[ $code =~ ^[0-9]{3}$ ]] || die "enrol: unreadable response (no status code)"
    err=$(printf '%s' "$body" | jq -rc '"\(.error // "-"): \(.message // "-")"' 2>/dev/null || echo '(no JSON body)')
    case "$code" in
      200) break ;;
      404) retry_wait "enrol: HTTP 404 $err (the server may not have this VM yet)" ;;
      429) retry_wait "enrol: HTTP 429 rate limited" "$ra" ;;
      5??) retry_wait "enrol: HTTP $code $err" "$ra" ;;
      *)   die "enrol: HTTP $code $err" ;;
    esac
  done
  unset tok

  # --- 4. enroll with the key on stdin; retried while the key is held, because the mint answers only once
  printf '%s' "$body" | jq -e 'type == "object"' >/dev/null 2>&1 || die "enrol: 200 without a JSON object"
  field() { printf '%s' "$body" | jq -r --arg k "$1" '.[$k] // empty'; }
  server=$(field server); board=$(field board); host_id=$(field host_id); name=$(field name); owner=$(field user)
  [ -n "$server" ] && [ -n "$board" ] && [ -n "$host_id" ] && [ -n "$name" ] && [ -n "$(field key)" ] \
    || die "enrol: 200 without server, board, host_id, name or key"
  printf 'OWNER=%q\nFULL_NAME=%q\nBOARD=%q\n' "$owner" "$name" "$board" > "$STATE/machine.env"
  backoff=5
  until field key | as_agent "conde enroll --server $(q "$server") --host $(q "$host_id") --board $(q "$board") --key-stdin"; do
    retry_wait "conde enroll failed (the key is still held)"
  done
  unset body
  date -u +%FT%TZ > "$ENROLLED"
  log "enrolled as $host_id on $board ($server); agent name $name"
fi

# --- 5. conde on this machine: bridge service, skill and MCP entries naming the board (after the enrollment)
as_agent 'conde setup' || die "conde setup"
date -u +%FT%TZ > "$STATE/bootstrap-done"

# --- 6. the agent: pinned session id (kept if this runs again), the unit enabled; it waits for the sign-in.
# agent.env is written by the agent itself, never by root into the agent's folders: fixed field names, every value
# through %q, the work folder from the agent's resolved home.
. "$STATE/machine.env"
as_agent "mkdir -p ~/$WORK_DIR_NAME"
if [ ! -f "$home/.config/agentvm/agent.env" ]; then
  printf '%s=%q\n' AGENT_NAME "${FULL_NAME#*/}" RC_NAME "$FULL_NAME" OWNER_LABEL "$OWNER" SESSION_ID "$(uuidgen)" \
    PERMISSION_MODE "$PERMISSION_MODE" WORK_DIR "$home/$WORK_DIR_NAME" \
    | as_agent 'umask 077 && mkdir -p ~/.config/agentvm && cat > ~/.config/agentvm/agent.env'
fi
as_agent 'systemctl --user daemon-reload && systemctl --user enable --now claude-agent agentvm-signin-check.timer'

date -u +%FT%TZ > "$DONE"
log "done; the agent starts when the person has signed in to Claude"
