# One Application per deploy/tenants/<name>.yaml; the tenant file is the chart's values file. Rendered by
# infra/gcp/cluster/argocd.tf, which fills the revision, the sync policy and the platform values.
apiVersion: argoproj.io/v1alpha1
kind: ApplicationSet
metadata:
  name: conde-workspaces
  namespace: argocd
spec:
  goTemplate: true
  goTemplateOptions: ["missingkey=error"]
  generators:
    - git:
        repoURL: ${repo_url}
        revision: ${revision}
        files:
          - path: deploy/tenants/*.yaml
  # Deleting a tenant file or this ApplicationSet leaves the workspace's objects in place.
  syncPolicy:
    preserveResourcesOnDeletion: true
  template:
    metadata:
      name: ws-{{ .name }}
    spec:
      project: conde
      source:
        repoURL: ${repo_url}
        targetRevision: ${revision}
        path: charts/conde-workspace
        helm:
          releaseName: conde
          valueFiles:
            - ../../deploy/image.yaml
            - ../../{{ .path.path }}/{{ .path.filename }}
          # Takes precedence over the value files, so a tenant file cannot change the platform values.
          valuesObject: ${platform_values}
      destination:
        server: https://kubernetes.default.svc
        namespace: ws-{{ .name }}
      syncPolicy: ${sync_policy}
